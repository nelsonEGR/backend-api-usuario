# Copia este archivo como referencia de las variables necesarias.
# .NET NO carga archivos .env automaticamente: usa variables de entorno reales,
# docker-compose con env_file o dotnet user-secrets en desarrollo.
# .env NO se versiona (esta en .gitignore).

ASPNETCORE_ENVIRONMENT=Development

# Cadena de conexion de PostgreSQL.
# Tambien se acepta DATABASE_URL con formato postgres://usuario:password@host/db
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=api_usuario;Username=postgres;Password=CAMBIAR;SslMode=Require

# API Key que deben enviar los clientes en el header X-API-KEY.
Security__ApiKey=CAMBIAR_API_KEY
# Opcional. Si se configura, los endpoints administrativos exigen X-ADMIN-KEY.
# Si no se configura, se usa Security__ApiKey como llave administrativa (compatibilidad).
Security__AdminApiKey=CAMBIAR_ADMIN_KEY

# true por defecto. Use false SOLO en local si necesita probar sin header.
Security__RequireApiKey=true

# Lista blanca de origenes CORS. En produccion configura tu frontend real.
# Cors__AllowedOrigins__0=https://mi-frontend.com
Cors__AllowAnyOrigin=true

# Habilitar Swagger. Por defecto solo en Development.
Swagger__Enabled=true

# Limites de peticiones por IP.
RateLimiting__PermitLimit=120
RateLimiting__WindowSeconds=60
RateLimiting__SensitivePermitLimit=10
RateLimiting__SensitiveWindowSeconds=60
